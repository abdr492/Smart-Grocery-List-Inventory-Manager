rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Catch-all Default Deny General Access
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Globally Reusable Primitive Guards
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // 3. Match Blocks for Collections

    // --- Pantry Collection ---
    match /pantry/{itemId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId) 
                    && isValidPantryItem(incoming()) 
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(itemId) 
                    && existing().userId == request.auth.uid
                    && isValidPantryItem(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isValidPantryItem(data) {
      return data.keys().hasAll(['id', 'name', 'quantity', 'unit', 'userId', 'category', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 8
        && data.keys().size() <= 11
        && data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.quantity is number && data.quantity >= 0
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
        && data.userId == request.auth.uid
        && data.category is string && data.category.size() > 0 && data.category.size() <= 30
        && (!data.keys().hasAll(['barcode']) || (data.barcode is string && data.barcode.size() <= 50))
        && (!data.keys().hasAll(['expiryDate']) || (data.expiryDate is string && data.expiryDate.size() <= 50))
        && (!data.keys().hasAll(['lowStockThreshold']) || (data.lowStockThreshold is number && data.lowStockThreshold >= 0));
    }

    // --- ShoppingList Collection ---
    match /shoppingList/{itemId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(itemId)
                    && isValidShoppingItem(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(itemId)
                    && existing().userId == request.auth.uid
                    && isValidShoppingItem(incoming())
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isValidShoppingItem(data) {
      return data.keys().hasAll(['id', 'name', 'quantity', 'unit', 'userId', 'checked', 'autoGenerated', 'createdAt', 'updatedAt'])
        && data.keys().size() >= 9
        && data.keys().size() <= 11
        && data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.quantity is number && data.quantity >= 0
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
        && data.userId == request.auth.uid
        && data.checked is bool
        && data.autoGenerated is bool
        && (!data.keys().hasAll(['barcode']) || (data.barcode is string && data.barcode.size() <= 50));
    }

    // --- ConsumptionLogs Collection ---
    match /consumptionLogs/{logId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId)
                    && isValidConsumptionLog(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().createdAt == request.time;
      // Consumption logs are historic/immutable: they can never be modified or deleted.
      allow update, delete: if false;
    }

    function isValidConsumptionLog(data) {
      return data.keys().hasAll(['id', 'userId', 'itemName', 'quantity', 'action', 'createdAt'])
        && data.keys().size() == 6
        && data.id is string
        && data.userId == request.auth.uid
        && data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 100
        && data.quantity is number && data.quantity >= 0
        && data.action is string && (data.action == 'consumed' || data.action == 'expired' || data.action == 'wasted' || data.action == 'purchased');
    }

    // --- UserSettings Collection ---
    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidUserSettings(incoming())
                    && incoming().userId == request.auth.uid
                    && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
                    && isValidUserSettings(incoming())
                    && incoming().userId == existing().userId
                    && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['userId', 'pushNotificationsEnabled', 'lowStockAlertsEnabled', 'expiryReminderDays', 'updatedAt'])
        && data.keys().size() >= 5
        && data.keys().size() <= 6
        && data.userId == request.auth.uid
        && data.pushNotificationsEnabled is bool
        && data.lowStockAlertsEnabled is bool
        && data.expiryReminderDays is number && data.expiryReminderDays >= 0 && data.expiryReminderDays <= 30
        && (!data.keys().hasAll(['customCategories']) || (data.customCategories is list && data.customCategories.size() <= 100));
    }
  }
}
